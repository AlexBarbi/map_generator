<?xml version="1.0"?>
<package format="3">
  <name>map_generator</name>
  <version>0.1.0</version>
  <description>
    Map tools on the SC-PGO output: merge the keyframes into one map without what moved, take the people out of a
    far_planner graph, pick inspection points on the map in the browser.
  </description>
  <maintainer email="alejandro.enrique.barbi@gmail.com">abarbi</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <!-- make_merged_map.py and prune_far_graph.py also need open3d (pip: the .venv of the workspace, setup_ranav.sh venv) -->
  <!-- map_point_picker.py live view (optional) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
